WEB_IMAGE=dorify/app:oracle-2026-11-06

# Public build parameters (never put secrets in VITE_*).
# Pass this file with -BuildEnvFile to deploy-oracle.ps1 after copying to a private file.
VITE_APP_ENV=development
VITE_DORIFY_DEPLOYMENT_MODE=cloud
VITE_PUBLIC_TRACKING_URL=https://app.dorify.fr
VITE_API_BASE_URL=http://localhost:3000
VITE_KIOSK_IDLE_MS=30000
VITE_SESSION_IDLE_MINUTES=30
VITE_LEGAL_ENTITY_NAME=Dorify - demonstration
VITE_LEGAL_ADDRESS=Adresse du responsable Dorify a renseigner
VITE_LEGAL_EMAIL=legal@dorify.fr
VITE_LEGAL_REGISTRATION=Immatriculation a renseigner
