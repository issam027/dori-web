# URL commune de l'API REST Dori et des flux temps réel SSE.
# Les flux SSE l'utilisent directement afin de conserver une connexion HTTP persistante.
VITE_API_BASE_URL=http://localhost:3000

# Environnement fonctionnel de l'application : development, test ou production.
VITE_APP_ENV=development

# Délai d'inactivité de la borne en millisecondes avant purge et retour à l'accueil.
VITE_KIOSK_IDLE_MS=30000

# Mot de passe temporaire partagé utilisé par l'action de reset administrateur (10 à 20 caractères).
# Cette variable VITE_* est intégrée au bundle navigateur : ne la considérez pas comme un secret.
VITE_USER_RESET_PASSWORD=DoriReset@2026

# Informations légales affichées dans l'application. Les valeurs fictives bloquent le build production.
VITE_LEGAL_ENTITY_NAME=Dori Développement
VITE_LEGAL_ADDRESS=1 rue du Développement, 75000 Paris
VITE_LEGAL_EMAIL=contact-dev@dori.local
VITE_LEGAL_REGISTRATION=DEV-LOCAL

# Indique une exécution en intégration continue et active les protections/retries Playwright.
CI=false

# Taille gzip maximale, en octets, du bundle JavaScript initial.
BUNDLE_INITIAL_JS_GZIP_BUDGET=125000

# Taille gzip maximale, en octets, de la feuille de styles initiale.
BUNDLE_INITIAL_CSS_GZIP_BUDGET=36000

# Taille gzip maximale, en octets, du plus gros bundle JavaScript secondaire.
BUNDLE_SECONDARY_JS_GZIP_BUDGET=45000

# Nombre minimal attendu de bundles de pages chargés à la demande.
BUNDLE_MINIMUM_PAGE_CHUNKS=15
